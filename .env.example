# Copy to .env and edit. Load it in every shell before running RAM:
#   set -a; source .env; set +a
# scripts/slurm/train.sbatch loads .env automatically.

# Shared directory for the CUDA 12.6 toolchain, the MMCV artifact, the uv
# environments and the uv cache. Put it on storage visible from every compute
# node, with ~30 GB free. Default: <repo>/.ram-shared
RAM_SHARED_ROOT=/path/to/shared/storage/ram-cuda126

# Conda, mamba or micromamba executable. Used once, by
# tools/install/ensure_cuda126_toolchain.sh, to create the CUDA 12.6 + GCC prefix.
RAM_CONDA_EXE=/path/to/conda

# Hugging Face token with access to stabilityai/stable-diffusion-3.5-medium
# (a gated model).
HF_TOKEN=hf_your_token_here

# Optional cache locations. Model weights otherwise live in <repo>/models
# (symlink it to large storage if needed) and in each library's default cache.
# RAM_OPEN_CLIP_CACHE_DIR=/path/to/cache/open_clip    # OpenCLIP weights (GenEval reward)
# RAM_PADDLEOCR_CACHE_DIR=/path/to/cache/paddleocr    # PaddleOCR models (OCR reward)

# Optional W&B logging (off unless a run sets --wandb_project).
# WANDB_API_KEY=
# WANDB_ENTITY=your-team
